# Public production site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.happyheartsonwheels.net

# Optional Google Search Console HTML-tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Square controls the live menu, prices, modifiers, sold-out availability,
# checkout, payments, and completed pickup orders.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-07-15
# Change this to the business's normal pickup preparation time.
SQUARE_PICKUP_PREP_TIME_MINUTES=20

# Add this exact public URL as a Square Production webhook endpoint after deployment.
# Subscribe only to: catalog.version.updated
SQUARE_WEBHOOK_NOTIFICATION_URL=https://www.happyheartsonwheels.net/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
