ORDER_NOTIFICATION_EMAIL=happyhearts2026@outlook.com

# Square hosted checkout
# Keep false until the server-side Square values below are configured.
NEXT_PUBLIC_SQUARE_ENABLED=false
SQUARE_ENVIRONMENT=propduction
SQUARE_ACCESS_TOKEN=EAAAl8PXPlWm8KLe4qlVZDzmdJeUeFe1w6LyvEyP52u-doSaK_loZIHomzLLnFb5
SQUARE_LOCATION_ID=L9TPVXZEG1049
SQUARE_API_VERSION=2026-07-15
SQUARE_APPLICATION_ID=sq0idp-ocbHebme7pC7t5xMl4ZRRw
# Create a Square webhook subscription for payment.created and payment.updated.
# The notification URL must exactly match the public endpoint below because it is
