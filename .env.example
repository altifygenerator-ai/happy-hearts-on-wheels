# Public production site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.happyheartsonwheels.net

# Optional Google Search Console HTML-tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Square is the source of truth for the live menu, prices, item photos,
# modifiers, sold-out availability, taxes, discounts, orders, and payments.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-07-15

# Website ordering follows the business hours saved on the Square location.
# Orders stop this many minutes before Square's closing time.
SQUARE_PICKUP_PREP_TIME_MINUTES=20

# SAFE ROLLOUT: keep this as hosted until the approval flow and printer are tested.
# hosted  = current Square-hosted checkout
# approval = authorize card first, staff accepts, then Square captures payment
SQUARE_PAYMENT_MODE=hosted

# Required only when SQUARE_PAYMENT_MODE=approval.
# This is the Production Application ID, NOT the secret access token.
SQUARE_APPLICATION_ID=
SQUARE_APPROVAL_TIMEOUT_MINUTES=15

# Required for /staff/orders when approval mode is enabled.
# Use a private password of at least 8 characters.
STAFF_ORDER_PASSWORD=

# Existing public Square webhook endpoint.
# Keep catalog.version.updated and add payment.updated before approval mode goes live.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://www.happyheartsonwheels.net/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Ordering safety heartbeat. In approval mode the website accepts new orders only
# while /staff/orders is actively checking in. Default is 240 seconds.
# Optional; leave unset to use the safe default.
STAFF_ORDER_HEARTBEAT_TTL_SECONDS=240
